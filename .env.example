# Google Gemini API Key
# Получить: https://aistudio.google.com/app/apikey
# Используется для доступа к Gemini 2.5 Pro
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# Brave Search API Key
# Получить: https://brave.com/search/api/
# Бесплатный tier: 2000 запросов/месяц
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# NextAuth Configuration
# Сгенерировать: openssl rand -base64 32
# Используется для шифрования сессий
AUTH_SECRET=your_auth_secret_here

# PostgreSQL Database (Neon)
# Получить: https://neon.tech
# Формат: postgresql://username:password@host/database
# Альтернатива: Vercel Postgres при деплое на Vercel
POSTGRES_URL=postgresql://username:password@host/database

# Vercel Blob Storage
# Получить: https://vercel.com/storage
# Используется для хранения документов
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# AssemblyAI API Key (Voice Input)
# Получить: https://www.assemblyai.com/dashboard/signup
# Бесплатный tier: $50 кредитов (~333 часа streaming)
# Используется для голосового ввода (Speech-to-Text)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Next.js Configuration
# URL приложения (для production заменить на реальный домен)
NEXT_PUBLIC_APP_URL=http://localhost:3000
