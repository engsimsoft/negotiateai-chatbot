# ===========================================
# Simply - Environment Variables
# ===========================================
# Скопируй этот файл в .env.local и заполни значения
# cp .env.example .env.local

# -------------------------------------------
# AI Providers
# -------------------------------------------

# Anthropic API Key (обязательно — основной AI-провайдер)
# Получить: https://console.anthropic.com/
# Используется для: Claude Sonnet 4.6 (чат), Haiku 4.5 (утилиты), Opus (проекты)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key (обязательно)
# Получить: https://aistudio.google.com/app/apikey
# Используется для: vision-ocr, briefing фильтр (Gemini Flash), подкаст TTS
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# OpenRouter API Key (опционально, legacy)
# Получить: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# xAI Grok API Key (опционально — для моделей Grok в Model Switchboard)
# Получить: https://console.x.ai/
# Используется для: Grok 4 / 4.1 / 4.20 через Model Switchboard (ТЗ-1)
XAI_API_KEY=your_xai_api_key_here

# xAI Management API Key (обязательно для Library / ТЗ-XAI-COL-1)
# Получить: https://console.x.ai/ → Management Keys → Create
# Используется для: Library (xAI Collections API) — CRUD коллекций, upload файлов, search
XAI_MANAGEMENT_API_KEY=your_xai_management_api_key_here

# -------------------------------------------
# Search & Tools
# -------------------------------------------

# Brave Search API Key (обязательно для инструмента поиска)
# Получить: https://brave.com/search/api/
# Бесплатный tier: 2000 запросов/месяц
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Perplexity API Key (для Deep Research tool)
# Получить: https://www.perplexity.ai/settings/api
# Используется для: Sonar Pro/Deep — глубокий поиск и анализ
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Jina API Key (для Fetch URL tool — headless Chrome fallback)
# Получить: https://jina.ai/reader/
# Используется для: чтение веб-страниц, которые не отдают контент напрямую
JINA_API_KEY=your_jina_api_key_here

# CloudConvert API Key (опционально, для конвертации файлов)
# Получить: https://cloudconvert.com/dashboard/api/v2/keys
# Используется для: конвертация документов (DOCX → PDF и т.д.)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here

# -------------------------------------------
# Embeddings & RAG
# -------------------------------------------

# Voyage AI API Key (для векторного поиска, эмбеддингов)
# Получить: https://dash.voyageai.com/ (200M токенов бесплатно)
# Используется для: MIND (память из чатов), Библиотека (база знаний)
VOYAGE_API_KEY=your_voyage_api_key_here

# -------------------------------------------
# Voice Input
# -------------------------------------------

# Deepgram API Key (опционально, для голосового ввода)
# Получить: https://console.deepgram.com/
# Бесплатный tier: $200 кредитов
# Используется для: Speech-to-Text (Nova-3, русский язык)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -------------------------------------------
# Authentication
# -------------------------------------------

# NextAuth Secret (обязательно)
# Сгенерировать: openssl rand -base64 32
# Используется для: шифрование сессий
AUTH_SECRET=your_auth_secret_here

# Trust Host (для production)
# Установить в true при деплое на Vercel
AUTH_TRUST_HOST=true

# -------------------------------------------
# Database
# -------------------------------------------

# PostgreSQL Database URL (обязательно)
# Получить: https://neon.tech или Vercel Postgres
# Формат: postgresql://username:password@host/database?sslmode=require
POSTGRES_URL=postgresql://username:password@host/database?sslmode=require

# -------------------------------------------
# Storage
# -------------------------------------------

# Vercel Blob Storage Token (обязательно)
# Получить: https://vercel.com/storage → Blob → Create Store
# Используется для: хранение документов, файлов
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# -------------------------------------------
# App Configuration
# -------------------------------------------

# URL приложения
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# Telegram Bot (ТЗ-TG3)
# -------------------------------------------

# Telegram Bot Token (обязательно для Telegram-интеграции)
# Получить: @BotFather в Telegram → /newbot
# Бот: @GetSimplyBot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Webhook Secret (обязательно для Telegram-интеграции)
# Любая случайная строка, например: openssl rand -hex 32
# Используется для: валидация webhook запросов от Telegram
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# -------------------------------------------
# Development
# -------------------------------------------

# Dev mode: inject [DEV] debug block into AI prompts
# Модель будет объяснять свои решения в формате [DEV] перед каждым ответом
# В production оставить пустым или убрать
SIMPLY_DEV_MODE=
