# ===========================================
# Simply - Environment Variables
# ===========================================
# Скопируй этот файл в .env.local и заполни значения
# cp .env.example .env.local

# -------------------------------------------
# AI Providers
# -------------------------------------------

# Google Gemini API Key (обязательно)
# Получить: https://aistudio.google.com/app/apikey
# Используется для: Gemini 2.5 Pro, Gemini 2.5 Flash
GOOGLE_GENERATIVE_AI_API_KEY=your_google_api_key_here

# OpenRouter API Key (опционально, для доступа к Claude)
# Получить: https://openrouter.ai/keys
# Используется для: Claude 3.5 Sonnet, Claude 3.5 Haiku (в проектах)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -------------------------------------------
# Search & Tools
# -------------------------------------------

# Brave Search API Key (обязательно для инструмента поиска)
# Получить: https://brave.com/search/api/
# Бесплатный tier: 2000 запросов/месяц
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# CloudConvert API Key (опционально, для конвертации файлов)
# Получить: https://cloudconvert.com/dashboard/api/v2/keys
# Используется для: конвертация документов (DOCX → PDF и т.д.)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here

# -------------------------------------------
# Voice Input
# -------------------------------------------

# Deepgram API Key (опционально, для голосового ввода)
# Получить: https://console.deepgram.com/
# Бесплатный tier: $200 кредитов
# Используется для: Speech-to-Text (Nova-3, русский язык)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# -------------------------------------------
# Authentication
# -------------------------------------------

# NextAuth Secret (обязательно)
# Сгенерировать: openssl rand -base64 32
# Используется для: шифрование сессий
AUTH_SECRET=your_auth_secret_here

# Trust Host (для production)
# Установить в true при деплое на Vercel
AUTH_TRUST_HOST=true

# -------------------------------------------
# Database
# -------------------------------------------

# PostgreSQL Database URL (обязательно)
# Получить: https://neon.tech или Vercel Postgres
# Формат: postgresql://username:password@host/database?sslmode=require
POSTGRES_URL=postgresql://username:password@host/database?sslmode=require

# -------------------------------------------
# Storage
# -------------------------------------------

# Vercel Blob Storage Token (обязательно)
# Получить: https://vercel.com/storage → Blob → Create Store
# Используется для: хранение документов, файлов
BLOB_READ_WRITE_TOKEN=your_blob_token_here

# -------------------------------------------
# App Configuration
# -------------------------------------------

# URL приложения
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------------------
# Development
# -------------------------------------------

# Dev mode: inject [DEV] debug block into AI prompts
# Модель будет объяснять свои решения в формате [DEV] перед каждым ответом
# В production оставить пустым или убрать
SIMPLY_DEV_MODE=
